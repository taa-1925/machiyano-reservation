</style>

<script is:inline>
  // --- 0. スクロール連動のゆったり横フェードイン演出 ---
  const revealTargets = document.querySelectorAll(".reveal-side, .reveal-side-right");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    revealTargets.forEach((el) => observer.observe(el));
  } else {
    revealTargets.forEach((el) => el.classList.add("is-visible"));
  }

  // --- 1. クロスフェード自動切り替えギャラリー（14枚対応） ---
  const slides = document.querySelectorAll("#fadeStage .fade-slide");
  const dots = document.querySelectorAll("#fadeDots .dot");
  const counterCurrent = document.getElementById("counterCurrent");
  let currentSlide = 0;
  let fadeTimer = null;

  function showFadeSlide(index) {
    if (slides.length === 0) return;
    const total = slides.length;
    currentSlide = (index + total) % total;

    slides.forEach((slide, i) => {
      slide.classList.toggle("is-active", i === currentSlide);
    });
    dots.forEach((dot, i) => {
      dot.classList.toggle("is-active", i === currentSlide);
    });
    if (counterCurrent) {
      counterCurrent.textContent = String(currentSlide + 1);
    }
  }

  function startFadeTimer() {
    stopFadeTimer();
    fadeTimer = setInterval(() => {
      showFadeSlide(currentSlide + 1);
    }, 4500);
  }

  function stopFadeTimer() {
    if (fadeTimer) {
      clearInterval(fadeTimer);
      fadeTimer = null;
    }
  }

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      const idx = Number(dot.dataset.index || 0);
      showFadeSlide(idx);
      startFadeTimer();
    });
  });

  startFadeTimer();

  // --- 2. カレンダー生成 ---
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  let viewYear = today.getFullYear();
  let viewMonth = today.getMonth();
  let selectedDateStr = "";

  const calMonthLabel = document.getElementById("calMonthLabel");
  const calendarGrid = document.getElementById("calendarGrid");
  const selectedDateInput = document.getElementById("selectedDate");

  function formatDate(y, m, d) {
    return `${y}-${String(m + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
  }

  function renderCalendar() {
    if (!calendarGrid || !calMonthLabel) return;
    calMonthLabel.textContent = `${viewYear}年 ${viewMonth + 1}月`;
    calendarGrid.innerHTML = "";

    const firstDay = new Date(viewYear, viewMonth, 1).getDay();
    const lastDate = new Date(viewYear, viewMonth + 1, 0).getDate();

    Array.from({ length: firstDay }).forEach(() => {
      calendarGrid.appendChild(document.createElement("div"));
    });

    Array.from({ length: lastDate }, (_, idx) => idx + 1).forEach((d) => {
      const cellDate = new Date(viewYear, viewMonth, d);
      const dayOfWeek = cellDate.getDay();
      const isClosed = dayOfWeek === 2 || dayOfWeek === 3;
      const isPast = today.getTime() > cellDate.getTime();
      const dateStr = formatDate(viewYear, viewMonth, d);

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "cal-day";
      if (cellDate.getTime() === today.getTime()) btn.classList.add("today");
      if (dateStr === selectedDateStr) btn.classList.add("selected");

      const numSpan = document.createElement("span");
      numSpan.textContent = String(d);
      btn.appendChild(numSpan);

      if (isClosed || isPast) {
        btn.classList.add("disabled");
        btn.disabled = true;
        if (isClosed) {
          const closedSpan = document.createElement("span");
          closedSpan.className = "closed-tag";
          closedSpan.textContent = "定休日";
          btn.appendChild(closedSpan);
        }
      } else {
        btn.addEventListener("click", () => {
          selectedDateStr = dateStr;
          if (selectedDateInput) selectedDateInput.value = dateStr;
          renderCalendar();
        });
      }

      calendarGrid.appendChild(btn);
    });
  }

  const prevMonthBtn = document.getElementById("prevMonth");
  const nextMonthBtn = document.getElementById("nextMonth");

  if (prevMonthBtn) {
    prevMonthBtn.addEventListener("click", () => {
      viewMonth -= 1;
      if (viewMonth === -1) {
        viewMonth = 11;
        viewYear -= 1;
      }
      renderCalendar();
    });
  }

  if (nextMonthBtn) {
    nextMonthBtn.addEventListener("click", () => {
      viewMonth += 1;
      if (viewMonth === 12) {
        viewMonth = 0;
        viewYear += 1;
      }
      renderCalendar();
    });
  }

  renderCalendar();

  // --- 3. 時間選択 ---
  const timeButtons = document.querySelectorAll("#timeChoices .time-btn");
  const selectedTimeInput = document.getElementById("selectedTime");

  timeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      timeButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      if (selectedTimeInput) selectedTimeInput.value = btn.dataset.value || "";
    });
  });

  // --- 4. フォーム送信（電話番号は任意） ---
  const form = document.getElementById("reservationForm");
  const formMessage = document.getElementById("formMessage");
  const submitBtn = document.getElementById("submitBtn");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!formMessage) return;

      const formData = new FormData(form);
      const payload = {
        date: String(formData.get("date") || ""),
        time: String(formData.get("time") || ""),
        party: String(formData.get("party") || ""),
        seat: String(formData.get("seat") || ""),
        name: String(formData.get("name") || "").trim(),
        email: String(formData.get("email") || "").trim(),
        phone: String(formData.get("phone") || "").trim(),
      };

      if (!payload.date || !payload.time || !payload.name || !payload.email) {
        formMessage.textContent = "ご希望日・ご来店時間・お名前・メールアドレスを入力してください。";
        formMessage.className = "form-msg error";
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "送信中...";
      formMessage.textContent = "";

      try {
        const res = await fetch("/api/reserve", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || "送信に失敗しました。");
        }

        formMessage.innerHTML = `ご予約リクエストを送信しました！確認メールをお送りしましたのでご確認ください。<br><span style="font-size: 0.85em; color: #666; display: inline-block; margin-top: 4px;">※自動返信メールが迷惑メールフォルダに振り分けられる場合がございます。届かない場合はそちらもあわせてご確認ください。</span>`;
        formMessage.className = "form-msg success";
        form.reset();
        selectedDateStr = "";
        if (selectedDateInput) selectedDateInput.value = "";
        if (selectedTimeInput) selectedTimeInput.value = "";
        timeButtons.forEach((b) => b.classList.remove("active"));
        renderCalendar();
      } catch (err) {
        formMessage.textContent = err.message || "送信中にエラーが発生しました。";
        formMessage.className = "form-msg error";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "この内容で予約希望を送る";
      }
    });
  }
</script>